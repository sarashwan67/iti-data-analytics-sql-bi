    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT T.Top_Name, C.Crs_Name, C.Crs_Duration
FROM Course C
JOIN Topic T ON C.Top_Id = T.Top_Id</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
