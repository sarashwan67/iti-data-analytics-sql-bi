  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@x">
            <Value>=Parameters!x.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT S.St_Fname + ' ' + S.St_lname AS StudentName, C.Crs_Name, SC.Grade
FROM Stud_Course SC
JOIN Student S ON SC.St_id = S.St_id
JOIN Course C ON SC.Crs_id = C.Crs_id
WHERE S.St_id=@x;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="StudentName">
          <DataField>StudentName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Crs_Name">
          <DataField>Crs_Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Grade">
          <DataField>Grade</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
